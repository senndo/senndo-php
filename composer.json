{
    "name": "senndo/senndo-php",
    "description": "Official PHP SDK for the senndo messaging and verification API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "senndo",
        "sms",
        "whatsapp",
        "email",
        "voice",
        "otp",
        "messaging",
        "cpaas"
    ],
    "homepage": "https://senndo.com",
    "support": {
        "docs": "https://senndo.com/developpeurs",
        "source": "https://github.com/senndo/senndo-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Senndo\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
